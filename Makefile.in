PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_VERSION = @PACKAGE_VERSION@

srcdir = @srcdir@
abs_srcdir = @abs_srcdir@
top_srcdir = @top_srcdir@
builddir = @builddir@
abs_builddir = @abs_builddir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
includedir = @includedir@
datarootdir = @datarootdir@
datadir = @datadir@
mandir = @mandir@

SHELL = @SHELL@
CC = @CC@
CFLAGS = @CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
AR = @AR@
RANLIB = @RANLIB@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

KSH_AUTOBUILD = $(SHELL) build-aux/autoconf-build

.PHONY: all check install uninstall clean distclean maintainer-clean show-config

all:
	$(KSH_AUTOBUILD) all

check:
	$(KSH_AUTOBUILD) check

install:
	$(KSH_AUTOBUILD) install

uninstall:
	$(KSH_AUTOBUILD) uninstall

clean:
	$(KSH_AUTOBUILD) clean

distclean: clean
	rm -f Makefile config.h config.log config.status build-aux/autoconf-build
	rm -rf autom4te.cache

maintainer-clean: distclean
	rm -f configure config.h.in

show-config:
	$(KSH_AUTOBUILD) show-config
